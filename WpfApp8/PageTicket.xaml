<Page x:Class="WpfApp8.PageTicket" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Билет" Background="#1A1A1A">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Оформление билета" FontSize="28" FontWeight="Bold" Foreground="#E50914" Margin="0,0,0,20"/>
        <Border Background="#2A2A2A" CornerRadius="8" Padding="20" Width="400">
            <StackPanel>
                <TextBlock x:Name="MovieTitleText" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <TextBlock x:Name="SessionInfoText" FontSize="16" Foreground="LightGray" Margin="0,0,0,10"/>
                <TextBlock x:Name="SeatInfoText" FontSize="16" Foreground="LightGray" Margin="0,0,0,20"/>
                <TextBlock x:Name="PriceText" FontSize="24" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,20"/>
                <Button Content="Подтвердить покупку" Click="Confirm_Click" Height="45" Background="#E50914" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>