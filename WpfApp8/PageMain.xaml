<Page x:Class="WpfApp8.PageMain" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Кинотеатр" Background="#1A1A1A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

     
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="КИНОТЕАТР" FontSize="32" FontWeight="Bold" Foreground="#E50914" VerticalAlignment="Center" Margin="0,0,30,0"/>

            <TextBox x:Name="SearchBox" Width="250" Height="35" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center" Padding="5"/>

            <ComboBox x:Name="SortBox" Width="180" Height="35" Margin="15,0" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="По названию" IsSelected="True"/>
                <ComboBoxItem Content="По рейтингу"/>
            </ComboBox>

            <Button Content="Личный кабинет" Click="GoToProfile_Click" Width="160" Height="35" Background="#E50914" Foreground="White"/>
            <Button Content="Вход/Регистрация" Click="GoToLogin_Click" Width="160" Height="35" Background="#333" Foreground="White" Margin="10,0,0,0"/>
        </StackPanel>


        <ListBox x:Name="MoviesList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#333" BorderThickness="1" Margin="10" Width="220" Background="#2A2A2A" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="Movie_Click" Tag="{Binding}">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Height="300" Stretch="UniformToFill"/>
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Rating, StringFormat=★ {0}}" Foreground="Gold" FontWeight="Bold"/>
                                    <Border Grid.Column="1" Background="#444" CornerRadius="3" Padding="5,2">
                                        <TextBlock Text="{Binding AgeLimit, StringFormat={}{0}+}" Foreground="LightGray" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>