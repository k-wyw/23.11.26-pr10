<Page x:Class="WpfApp8.PageLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Вход" Background="#1A1A1A">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Вход в систему" FontSize="28" FontWeight="Bold" Foreground="#E50914" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Логин:" Foreground="White"/>
        <TextBox x:Name="LoginBox" Width="250" Margin="0,5,0,10" Padding="5"/>
        <TextBlock Text="Пароль:" Foreground="White"/>
        <PasswordBox x:Name="PassBox" Width="250" Margin="0,5,0,20" Padding="5"/>

        <Button Content="Войти" Click="Login_Click" Height="40" Background="#E50914" Foreground="White" FontWeight="Bold"/>
        <Button Content="Зарегистрироваться" Click="Register_Click" Height="40" Background="#333" Foreground="White" Margin="0,10,0,0"/>
        <Button Content="На главную" Click="Back_Click" Height="30" Background="Transparent" Foreground="Gray" Margin="0,20,0,0"/>
    </StackPanel>
</Page>