<Page x:Class="WpfApp8.PageMovie" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Фильм" Background="#1A1A1A">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="MovieImage" Grid.Column="0" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,20,0"/>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="TitleText" FontSize="32" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescText" FontSize="14" Foreground="LightGray" TextWrapping="Wrap" Margin="0,10,0,20" LineHeight="20"/>

            <TextBlock Text="Сеансы:" FontSize="20" FontWeight="Bold" Foreground="#E50914" Margin="0,0,0,10"/>
            <ListBox x:Name="SessionsList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A" Padding="15,10" Margin="0,5" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StartTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Hall.Name}" Grid.Column="1" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Hall.Rating}" Grid.Column="2" Foreground="Gold" VerticalAlignment="Center"/>
                                <Button Content="Выбрать" Grid.Column="3" Click="SelectSession_Click" Tag="{Binding}" Background="#E50914" Foreground="White" Padding="15,5"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>