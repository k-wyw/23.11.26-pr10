<Page x:Class="WpfApp8.PageProfile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Профиль" Background="#1A1A1A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
            <Button Content="На главную" Click="GoToMain_Click" Width="150" Height="35" Background="#333" Foreground="White"/>
            <TextBlock Text="Личный кабинет" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <TextBlock x:Name="UserInfoText" FontSize="18" Foreground="White" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Мои билеты:" FontSize="20" FontWeight="Bold" Foreground="#E50914" Margin="0,0,0,10"/>
            <ListBox x:Name="TicketsList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A" Padding="15,10" Margin="0,5" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Binding Session.Movie.Title}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Session.StartTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="LightGray" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Session.Hall.Name, StringFormat=Зал: {0}}" Foreground="LightGray"/>
                                <TextBlock Text="{Binding RowNumber, StringFormat=Ряд: {0}}" Foreground="Gold" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding SeatNumber, StringFormat=Место: {0}}" Foreground="Gold"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>